# --- Neon PostgreSQL (server-side only) ---
# Provided by the Neon integration installed from the Vercel Marketplace.
# Prefer the POOLED connection string (Neon "Connection pooling" toggle / "-pooler" host)
# because Vercel Functions are short-lived and may spawn many concurrent invocations.
# Never prefix this with VITE_/NEXT_PUBLIC_ and never ship it to the browser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: separate database used by integration tests (see tests/integration).
# If unset, DB-backed integration tests are skipped.
TEST_DATABASE_URL=

# Optional: session cookie lifetime in seconds (default 2592000 = 30 days).
SESSION_TTL_SECONDS=2592000

# Optional: disables the Secure flag on cookies for plain-HTTP local development.
# Leave unset/empty in production. Vercel requests are detected via x-forwarded-proto.
INSECURE_COOKIES=
