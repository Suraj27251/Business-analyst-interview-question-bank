# Local development only. Use a Neon development/preview branch, not production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
# Migration administration only; never use this as the function runtime URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_ALLOWED_SUBJECT=replace-with-numeric-github-user-id
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000
